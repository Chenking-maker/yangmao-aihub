# 复制为 .dev.vars 后填入真实值（.dev.vars 已被 .gitignore 忽略，绝不进 Git）

# 好单库开放平台 → 我的应用 → apikey
HDK_APIKEY=

# 淘宝转链（返利）三件套：
#   PID = 淘宝联盟推广位 mm_xxx_xxx_xxx
#   TB_NAME = 在好单库后台授权后的淘宝账号昵称
HDK_PID=
HDK_TB_NAME=

# LLM（OpenAI 兼容协议，任选其一）：
#   DeepSeek   https://api.deepseek.com/v1        deepseek-chat
#   智谱       https://open.bigmodel.cn/api/paas/v4   glm-4-plus
#   硅基流动   https://api.siliconflow.cn/v1      deepseek-ai/DeepSeek-V3
#   月之暗面   https://api.moonshot.cn/v1         kimi-k2
LLM_API_KEY=
