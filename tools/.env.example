# 羊毛AIHUB 本地开发代理配置（复制为 .env 后填写，.env 不进 Git）

# ---- 选品数据 ----
HDK_APIKEY=

# ---- 淘宝转链归因（好单库后台完成淘宝授权后生效）----
HDK_PID=
HDK_TB_NAME=            # 授权的淘宝昵称，如 chenking陈逸希；决定佣金归因到谁的推广位

# ---- 京东转链归因（好单库后台 auth?platform=2 开通京东官方账号后生效）----
JD_UNION_ID=            # 京东联盟ID
JD_AUTH_KEY=            # 授权KEY
JD_AUTH_EXPIRE=         # 授权到期时间

# ---- LLM（可选，配置后 AI 对话走大模型；不配则前端用实时检索演示模式）----
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# 备选模型：
#   Qwen/Qwen2.5-7B-Instruct   快（~1.5s），工具调用稳，默认
#   Qwen/Qwen2.5-14B-Instruct  质量略高（~5.5s）
#   zai-org/GLM-5.3-Flash      推理模型，慢（~27s），需 enable_thinking:false
